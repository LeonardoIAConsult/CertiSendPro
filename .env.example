# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MERCADO_PAGO_ACCESS_TOKEN: Required for real payments via Mercado Pago in Colombia.
# Get your credentials at mercadopago.com/developers
MERCADO_PAGO_ACCESS_TOKEN="MY_MERCADO_PAGO_ACCESS_TOKEN"

# PUBLIC_BASE_URL: dominio PUBLICO (https, nunca localhost) donde vive este servicio en
# produccion. Lo usa /api/mercadopago/create-preference para armar `notification_url`
# (https://<PUBLIC_BASE_URL>/api/mp/webhook?src=certisend), la URL que Mercado Pago llama desde
# sus propios servidores cuando confirma un pago. Si falta, cae en https://certisendpro.online
# (dominio de Hosting de este proyecto). Fijar en Cloud Run solo si ese dominio cambia.
PUBLIC_BASE_URL="https://certisendpro.online"

# PROVEEDOR_NOMBRE / PROVEEDOR_DOC / PROVEEDOR_DIR / PROVEEDOR_TEL: identidad del proveedor
# (Tarea 11, cobro real con planes) que va en el pie del acuse de compra (server/avisos.ts) y en
# los textos legales. NUNCA se escriben valores reales aqui (este archivo es de ejemplo y SI se
# versiona): se fijan en Cloud Run / Secret Manager en produccion. Si falta alguna, el pie del
# acuse muestra "[PENDIENTE]" y el envio del acuse queda bloqueado hasta completarla.
PROVEEDOR_NOMBRE="MY_PROVEEDOR_NOMBRE"
PROVEEDOR_DOC="MY_PROVEEDOR_DOC"
PROVEEDOR_DIR="MY_PROVEEDOR_DIR"
PROVEEDOR_TEL="MY_PROVEEDOR_TEL"

# HUELLA_LOTE_SECRET: clave HMAC-SHA256 con la que el servidor firma, al iniciar un lote
# (POST /api/lote/iniciar), la huella de cada par pagina-fila-correo confirmado en la pantalla de
# revision (Tarea 15, requisito A.3; GRAVE 2, correccion vuelta 31, 2026-10-06). SIN esta
# variable, el servidor NUNCA autoriza un lote (falla cerrado: 503 "Configuración incompleta" en
# /api/lote/iniciar y en /api/send-email) — antes, sin ella, el lote se creaba igual pero sin
# huella, asi que /api/send-email no tenia nada contra que comprobar lo que de verdad se envia.
# GET /api/health reporta si esta configurada (`huella: true|false`), SIN revelar su valor.
# Generarla una sola vez y guardarla en Secret Manager (ver docs/ops.md, seccion "Huella HMAC de
# lotes"); NUNCA un valor fijo ni corto. Ejemplo de generacion local (no commitear el resultado):
#   openssl rand -hex 32
HUELLA_LOTE_SECRET="MY_HUELLA_LOTE_SECRET"
