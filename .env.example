# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MERCADO_PAGO_ACCESS_TOKEN: Required for real payments via Mercado Pago in Colombia.
# Get your credentials at mercadopago.com/developers
MERCADO_PAGO_ACCESS_TOKEN="MY_MERCADO_PAGO_ACCESS_TOKEN"

# PUBLIC_BASE_URL: dominio PUBLICO (https, nunca localhost) donde vive este servicio en
# produccion. Lo usa /api/mercadopago/create-preference para armar `notification_url`
# (https://<PUBLIC_BASE_URL>/api/mp/webhook?src=certisend), la URL que Mercado Pago llama desde
# sus propios servidores cuando confirma un pago. Si falta, cae en https://certisendpro.online
# (dominio de Hosting de este proyecto). Fijar en Cloud Run solo si ese dominio cambia.
PUBLIC_BASE_URL="https://certisendpro.online"

# PROVEEDOR_NOMBRE / PROVEEDOR_DOC / PROVEEDOR_DIR / PROVEEDOR_TEL: identidad del proveedor
# (Tarea 11, cobro real con planes) que va en el pie del acuse de compra (server/avisos.ts) y en
# los textos legales. NUNCA se escriben valores reales aqui (este archivo es de ejemplo y SI se
# versiona): se fijan en Cloud Run / Secret Manager en produccion. Si falta alguna, el pie del
# acuse muestra "[PENDIENTE]" y el envio del acuse queda bloqueado hasta completarla.
PROVEEDOR_NOMBRE="MY_PROVEEDOR_NOMBRE"
PROVEEDOR_DOC="MY_PROVEEDOR_DOC"
PROVEEDOR_DIR="MY_PROVEEDOR_DIR"
PROVEEDOR_TEL="MY_PROVEEDOR_TEL"

# HUELLA_LOTE_SECRET: clave HMAC-SHA256 con la que el servidor firma, al iniciar un lote
# (POST /api/lote/iniciar), la huella de cada par pagina-fila-correo confirmado en la pantalla de
# revision (Tarea 15, requisito A.3; GRAVE 2, correccion vuelta 31, 2026-10-06). SIN esta
# variable, el servidor NUNCA autoriza un lote (falla cerrado: 503 "Configuración incompleta" en
# /api/lote/iniciar y en /api/send-email) — antes, sin ella, el lote se creaba igual pero sin
# huella, asi que /api/send-email no tenia nada contra que comprobar lo que de verdad se envia.
# GET /api/health reporta si esta configurada (`huella: true|false`), SIN revelar su valor.
# Generarla una sola vez y guardarla en Secret Manager (ver docs/ops.md, seccion "Huella HMAC de
# lotes"); NUNCA un valor fijo ni corto. Ejemplo de generacion local (no commitear el resultado):
#   openssl rand -hex 32
HUELLA_LOTE_SECRET="MY_HUELLA_LOTE_SECRET"

# ── Resto de variables de SERVIDOR que lee el codigo (completado tras el REVISOR_EXTERNO,
# 2026-10-06, Medio 3: esta lista tiene que cubrir TODO `process.env.*` que server.ts/server/*.ts
# de verdad leen, no solo las que ya tenian comentario) ─────────────────────────────────────────

# NODE_ENV: estandar de Node. En produccion (Cloud Run) debe ser "production" — server.ts lo usa
# para decidir si sirve el dev server de Vite (middleware mode) o los estaticos ya compilados de
# dist/. Sin valor, se trata como entorno de desarrollo.
NODE_ENV="production"

# PORT: puerto donde escucha Express (server.ts). Cloud Run lo inyecta solo; en local, 3000 si
# falta.
PORT="3000"

# ALLOWED_ORIGINS: origenes (scheme+host+puerto) separados por comas desde los que el navegador
# puede llamar a /api/*; cualquier otro origen recibe 403 "Origen no permitido". Sin valor, cae en
# los dos origenes de desarrollo local ("http://localhost:3000,http://localhost:5173") — en
# produccion DEBE fijarse al dominio real de Hosting.
ALLOWED_ORIGINS="https://certisendpro.online"

# PAGOS_ACTIVOS: interruptor maestro del cobro real ("1" = encendido). Cualquier otro valor o
# ausente = apagado: /api/mercadopago/create-preference responde 503 y la tarjeta del Paquete usa
# el flujo de mailto (ver src/components/LandingPage.tsx, `pagosActivos` de /api/precios). NUNCA
# encender en produccion sin cerrar antes las condiciones P1/P3/P4/P5 de
# OUTPUTS/legal/certisend-cobro-2026-10-05/VERIFICACION-ronda5.md (fuera de este repo).
PAGOS_ACTIVOS="0"

# RATE_LIMIT_PER_MIN: tope del limitador GLOBAL (por uid si hay sesion valida, si no por IP) de
# /api/* (server.ts, `app.use("/api", ...)`). Por defecto 30/min si falta.
RATE_LIMIT_PER_MIN="30"

# RATE_LIMIT_COBROS_PER_MIN / RATE_LIMIT_COBROS_UID_PER_MIN: topes de
# /api/mercadopago/create-preference — el primero GLOBAL (todos los uid juntos, 20/min por
# defecto), el segundo POR uid (3/min por defecto). Los dos corren DESPUES de `exigirAuth`
# (M29, corrige vuelta 24): sin token valido nunca se gasta ningun cupo.
RATE_LIMIT_COBROS_PER_MIN="20"
RATE_LIMIT_COBROS_UID_PER_MIN="3"

# RATE_LIMIT_WEBHOOK_PER_MIN: tope por IP, separado del limitador general de /api, de
# POST /api/mp/webhook (el propio Mercado Pago). Por defecto 60/min si falta.
RATE_LIMIT_WEBHOOK_PER_MIN="60"

# SCHEDULER_SA_EMAIL / SCHEDULER_AUDIENCE: identidad OIDC que debe traer el token del job de Cloud
# Scheduler que dispara POST /api/tareas/barrido-acuses (server/schedulerAuth.ts) — sin esto, el
# barrido completo de acuses pendientes no tiene como autenticarse. Ver docs/ops.md secciones 0/2
# para los valores reales de este proyecto (NUNCA se escriben en un archivo versionado).
SCHEDULER_SA_EMAIL="MY_SCHEDULER_SA_EMAIL"
SCHEDULER_AUDIENCE="MY_SCHEDULER_AUDIENCE"

# AVISOS_RELAY_URL / AVISOS_RELAY_SECRET: URL del relay de Apps Script (docs/relay/README.md) y el
# secreto HMAC compartido con el que server/avisos.ts firma cada aviso transaccional (venta,
# reembolso/reversion, acuse de compra, aviso a Leonardo). Sin las dos, ningun correo sale
# (`enviarCorreoReal` registra el motivo sin lanzar) y GET /api/health reporta `relay: false`.
AVISOS_RELAY_URL="MY_AVISOS_RELAY_URL"
AVISOS_RELAY_SECRET="MY_AVISOS_RELAY_SECRET"

# ── Variables de BUILD del cliente (Vite, "npm run build" / "npm run dev") ──────────────────────
# El SERVIDOR nunca las lee (no son `process.env.*`): Vite las incrusta en el bundle de src/ al
# momento de compilar (`import.meta.env.VITE_*`), asi que hay que fijarlas en el entorno que
# corre el build de Hosting, no en Cloud Run.
#
# IMPORTANTE (docs/ops.md, seccion "0bis"): VITE_PROVEEDOR_NOMBRE debe ser IDENTICO, caracter por
# caracter, al PROVEEDOR_NOMBRE que tiene fijado el servicio Cloud Run `certisend-api` en ESE
# momento — el servidor rechaza con 409 la autorizacion de datos (T11) si el nombre que el
# usuario vio y acepto en el cliente no coincide con el que el propio servidor usa en su copia
# del mismo texto (server.ts, "Medio 2, correccion vuelta 33").
VITE_PROVEEDOR_NOMBRE="MY_PROVEEDOR_NOMBRE"
VITE_PROVEEDOR_DOC="MY_PROVEEDOR_DOC"
VITE_PROVEEDOR_DIR="MY_PROVEEDOR_DIR"
VITE_PROVEEDOR_TEL="MY_PROVEEDOR_TEL"
