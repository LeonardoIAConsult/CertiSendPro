// Reglas de Firestore para la base de datos nombrada de CertiSend (Tarea 2, 2026-10-05).
// Las colecciones de cuentas y pagos solo las toca el servidor con firebase-admin, que las
// reglas de seguridad NO le aplican. El navegador (SDK cliente) queda denegado por completo:
// el plan y el saldo del usuario se consultan via /api/cuenta, nunca leyendo el documento.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // cuentas/{uid}: plan, saldo de envios, vencimiento, renovacion, suscripcion de MP.
    match /cuentas/{uid} {
      allow read, write: if false;
    }

    // pagosProcesados/{mpId}: idempotencia del webhook de Mercado Pago.
    match /pagosProcesados/{mpId} {
      allow read, write: if false;
    }

    // lotes/{loteId}: lotes de envio autorizados por /api/lote/iniciar (Tarea 3, 2026-10-05).
    // El saldo y el cupo los cuenta solo el servidor; el navegador nunca lee ni escribe esto.
    match /lotes/{loteId} {
      allow read, write: if false;
    }

    // preferencias/{id}: precio en COP/TRM que se ofrecio al crear un cobro (Tarea 6, 2026-10-05).
    // El webhook de Mercado Pago la vuelve a leer para comprobar que lo cobrado coincide con lo
    // ofrecido; el navegador nunca lee ni escribe esto.
    match /preferencias/{id} {
      allow read, write: if false;
    }
  }
}
