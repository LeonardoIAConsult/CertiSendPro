{
  "firestore": [
    {
      "database": "ai-studio-distribuidordece-740c63fd-b7de-43a7-92b2-a00fc7f81a8a",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server.cjs*"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "certisend-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}